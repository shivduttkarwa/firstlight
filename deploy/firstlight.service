[Unit]
Description=Firstlight API (gunicorn)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=firstlight
Group=firstlight
WorkingDirectory=/srv/firstlight/app/backend
RuntimeDirectory=firstlight
ExecStart=/srv/firstlight/app/backend/.venv/bin/gunicorn firstlight.wsgi:application \
    --bind unix:/run/firstlight/gunicorn.sock \
    --workers 2 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
